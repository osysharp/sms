// The app's text-message setup. In a file of its own with no `namespace`, because an `app.X = …` statement's value is
// resolved outside the file's namespace — the `using` below is what lets it name the app's own sender.
using Osysharp.Sms;
using SmsKitTests;

app.Sms = new SmsSetup { Sender = new RecordingSmsSender(), From = "Acme" };
